{
	"element": "lay-out",
	"layoutContainer": {
		"element": "body",
		"maxWidth": 1024,
		"margin": "1rem",
		"setRoot": true
	},
	"core": [
		"base",
		"group"
	],
	"common": [
		"animations"
	],
	"spacing": {
		"steps": [0, 1, 2, 3, 4,
			{"label": "2xs", "value": 0.125},
			{"label": "xs", "value": 0.25},
			{"label": "sm", "value": 0.5},
			{"label": "md", "value": 1},
			{"label": "lg", "value": 1.5},
			{"label": "xl", "value": 2},
			{"label": "2xl", "value": 3}
		],
		"tokens": ["p", "pi", "pb", "pbs", "pbe", "mbs", "mbe", "cg", "rg"],
		"breakpoints": ["xs", "lg"]
	},
	"breakpoints": {
		"xs": {
			"type": "@media",
			"srcsetMin": "240px",
			"layouts": [
				"autofit",
				"stack"
			]
		},
		"sm": {
			"type": "@media",
			"min": "380px",
			"layouts": [
				"autofit",
				"lanes",
				"stack",
				{
					"columns": [
						"columns(2)"
					],
					"grid": [
						"grid(3a)"
					],
					"mosaic": [
						"mosaic(photo)"
					]
				}
			]
		},
		"md": {
			"type": "@media",
			"min": "540px",
			"layouts": [
				"columns",
				"lanes",
				"stack",
				{
					"grid": [
						"grid(3a)"
					]
				}
			]
		},
		"lg": {
			"type": "@media",
			"min": "720px",
			"layouts": [
				"asymmetrical",
				"bento",
				"columns",
				"grid",
				"lanes",
				"ratios",
				"stack"
			]
		},
		"xl": {
			"type": "@media",
			"min": "920px",
			"layouts": [
				"stack",
				{
					"bento": [
						"bento(6a)"
					],
					"mosaic": [
						"mosaic(scatter)",
						"mosaic(hex)",
						"mosaic(pinwheel)",
						"mosaic(cornerstone)"
					]
				}
			]
		},
		"xxl": {
			"type": "@media",
			"min": "1140px",
			"layouts": [
				"stack",
				{
					"bento": [
						"bento(6a)"
					]
				}
			]
		}
	}
}

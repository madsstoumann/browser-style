{
	"$schema": "../schemas/form-types.schema.json",
	"package": "core",
	"title": "Core",
	"description": "The field types every form can use. Country and domain types (national ids, bank numbers, …) are installed as their own packages.",
	"version": "0.1.0",
	"types": [
		{ "kind": "text", "title": "Text", "description": "One line of text", "group": "Answers", "glyph": "Aa", "keywords": ["string", "input", "name"], "template": { "type": "string" }, "settings": ["placeholder", "length", "pattern", "checks", "default"] },
		{ "kind": "textarea", "title": "Long text", "description": "Several lines, for comments and descriptions", "group": "Answers", "glyph": "¶", "keywords": ["multiline", "comment", "message"], "template": { "type": "string", "ui": { "widget": "textarea" } }, "settings": ["placeholder", "length", "checks"] },
		{ "kind": "number", "title": "Number", "description": "Any number, decimals allowed", "group": "Answers", "glyph": "1.5", "keywords": ["decimal", "amount"], "template": { "type": "number" }, "settings": ["range", "checks", "default"] },
		{ "kind": "integer", "title": "Whole number", "description": "A number without decimals", "group": "Answers", "glyph": "123", "keywords": ["integer", "count", "amount"], "template": { "type": "integer" }, "settings": ["range", "checks", "default"] },
		{ "kind": "slider", "title": "Slider", "description": "A number picked on a scale between a lowest and a highest value", "group": "Answers", "glyph": "⊸", "keywords": ["range", "scale", "slider", "amount"], "template": { "type": "number", "ui": { "widget": "range" }, "validation": { "minimum": 0, "maximum": 100 }, "default": 50 }, "settings": ["range", "default"] },
		{ "kind": "date", "title": "Date", "description": "A calendar date", "group": "Answers", "glyph": "📅", "keywords": ["day", "birthday", "calendar"], "template": { "type": "string", "ui": { "widget": "date" } }, "settings": ["checks"] },
		{ "kind": "time", "title": "Time", "description": "A time of day", "group": "Answers", "glyph": "🕑", "keywords": ["clock", "hour"], "template": { "type": "string", "ui": { "widget": "time" } }, "settings": [] },
		{ "kind": "select", "title": "Dropdown", "description": "One choice from a list", "group": "Choices", "glyph": "☰", "keywords": ["select", "choice", "list", "option"], "template": { "type": "select", "options": { "choices": [{ "value": "a", "label": "Option A" }, { "value": "b", "label": "Option B" }] } }, "settings": ["choices"] },
		{ "kind": "radio", "title": "Radio buttons", "description": "One choice, all options visible", "group": "Choices", "glyph": "◉", "keywords": ["choice", "option", "single"], "template": { "type": "select", "ui": { "widget": "radio" }, "options": { "choices": [{ "value": "a", "label": "Option A" }, { "value": "b", "label": "Option B" }] } }, "settings": ["choices"] },
		{ "kind": "checkboxes", "title": "Checkboxes", "description": "Several choices from a list", "group": "Choices", "glyph": "☑", "keywords": ["multiple", "choice", "option", "many"], "template": { "type": "select", "options": { "multiple": true, "choices": [{ "value": "a", "label": "Option A" }, { "value": "b", "label": "Option B" }] } }, "settings": ["choices"] },
		{ "kind": "boolean", "title": "Yes / no", "description": "A switch that is on or off", "group": "Choices", "glyph": "y/n", "keywords": ["toggle", "switch", "boolean", "checkbox"], "template": { "type": "boolean" }, "settings": [] },
		{ "kind": "email", "title": "Email", "description": "An email address", "group": "Contact", "glyph": "@", "privacy": "personal", "keywords": ["mail", "e-mail"], "template": { "type": "string", "ui": { "widget": "email" } }, "settings": ["placeholder", "checks"] },
		{ "kind": "tel", "title": "Phone", "description": "A phone number", "group": "Contact", "glyph": "☎", "privacy": "personal", "keywords": ["telephone", "mobile", "tel"], "template": { "type": "string", "ui": { "widget": "tel" } }, "settings": ["placeholder", "pattern", "checks"] },
		{ "kind": "url", "title": "Web address", "description": "A link to a page", "group": "Contact", "glyph": "🔗", "keywords": ["url", "link", "website"], "template": { "type": "string", "ui": { "widget": "url" } }, "settings": ["placeholder"] },
		{ "kind": "consent", "title": "Consent", "description": "A box the person ticks to agree; the wording and notice version are recorded with the answer", "group": "Content", "glyph": "✔", "keywords": ["gdpr", "agree", "terms", "privacy", "permission", "newsletter"], "template": { "type": "boolean", "ui": { "widget": "consent" }, "consent": { "text": "I agree that you may contact me about my enquiry.", "notice": { "label": "Privacy notice", "url": "", "version": "1" } } }, "settings": ["consent"] },
		{ "kind": "text-block", "title": "Text block", "description": "Text between fields, with no answer", "group": "Content", "glyph": "T", "keywords": ["paragraph", "info", "heading", "content", "notice"], "template": { "type": "content", "title": "", "content": "Write the text here." }, "settings": ["content"] },
		{ "kind": "hidden", "title": "Hidden value", "description": "Sent with the answers but not shown: a fixed value or one from the page (campaign, channel, …)", "group": "Advanced", "glyph": "◌", "keywords": ["hidden", "tracking", "campaign", "utm", "context"], "template": { "type": "string", "ui": { "widget": "hidden" } }, "settings": ["default", "source"] },
		{ "kind": "calculated", "title": "Calculated value", "description": "A total, a price or a score the rules work out from other answers; shown, never typed, and worked out again by the server", "group": "Advanced", "glyph": "∑", "keywords": ["calculated", "computed", "total", "sum", "price", "formula", "output"], "template": { "type": "number", "ui": { "widget": "output" } }, "settings": ["calculated"] },
		{ "kind": "file", "title": "File upload", "description": "One or more files, sent only with the final submit and never saved in a draft", "group": "Advanced", "glyph": "📎", "privacy": "personal", "keywords": ["upload", "attachment", "document", "image", "pdf"], "template": { "type": "file", "validation": { "maxFiles": 1, "maxSize": 10485760 } }, "settings": ["files"] }
	]
}

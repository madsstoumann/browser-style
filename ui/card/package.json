      "optional": true
    },
    "@browser.style/common": {
      "optional": true
    },
    "@browser.style/beacon": {
      "optional": true
    },
    "@browser.style/chip": {
      "optional": true
    },
    "@browser.style/lightbox": {
      "optional": true
    },
    "@browser.style/marquee": {

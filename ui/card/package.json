{
  "name": "@browser.style/card",
  "version": "4.0.0",
  "description": "CSS-first card engine built on <ui-media> + <ui-content>, with variant tokens and a container-driven font scale. Shared base for ui-reveal.",
  "type": "module",
  "main": "index.js",
  "style": "index.css",
  "exports": {
    ".": {
      "style": "./index.css",
      "import": "./index.js"
    },
    "./style": "./index.css",
    "./index.css": "./index.css",
    "./ui-card.css": "./ui-card.css",
    "./content.typography.css": "./content.typography.css",
    "./ui-media-srcset.js": "./ui-media-srcset.js",
    "./srcset.js": "./srcset.js",
    "./index.js": "./index.js",
    "./carousel.js": "./carousel.js",
    "./hover.js": "./hover.js",
    "./video.js": "./video.js",
    "./shared.js": "./shared.js",
    "./render.js": "./render.js",
    "./index.min.js": "./index.min.js",
    "./carousel.min.js": "./carousel.min.js",
    "./hover.min.js": "./hover.min.js",
    "./video.min.js": "./video.min.js"
  },
  "files": [
    "index.css",
    "ui-card.css",
    "media.css",
    "media.shapes.css",
    "media.hover.css",
    "media.tint.css",
    "media.carousel.css",
    "media.video.css",
    "content.css",
    "content.typography.css",
    "ui-media-srcset.js",
    "srcset.js",
    "index.js",
    "carousel.js",
    "hover.js",
    "video.js",
    "shared.js",
    "render.js",
    "data/",
    "*.min.js"
  ],
  "scripts": {
    "build": "node build.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "browser.style",
    "card",
    "css-first",
    "ui-media",
    "ui-content",
    "container-queries",
    "design-system"
  ],
  "author": "Mads Stoumann",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madsstoumann/browser-style.git",
    "directory": "ui/card"
  },
  "homepage": "https://browser.style/ui/card",
  "peerDependencies": {
    "@browser.style/base": "^1.0.11"
  }
}

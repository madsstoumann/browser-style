{
  "name": "@browser.style/card",
  "version": "4.0.0",
  "description": "CSS-first card engine built on <ui-media> + <ui-content>, with variant tokens and a container-driven font scale. Shared base for ui-reveal.",
  "type": "module",
  "main": "index.js",
  "style": "./dist/card.css",
  "exports": {
    ".": {
      "style": "./dist/card.css",
      "import": "./index.js"
    },
    "./style": "./dist/card.css",
    "./index.css": "./index.css",
    "./ui-card.css": "./ui-card.css",
    "./media.css": "./media.css",
    "./media.shapes.css": "./media.shapes.css",
    "./media.hover.css": "./media.hover.css",
    "./media.tint.css": "./media.tint.css",
    "./media.carousel.css": "./media.carousel.css",
    "./media.lightbox.css": "./media.lightbox.css",
    "./media.video.css": "./media.video.css",
    "./content.css": "./content.css",
    "./content.typography.css": "./content.typography.css",
    "./ui-media-srcset.js": "./ui-media-srcset.js",
    "./srcset.js": "./srcset.js",
    "./index.js": "./index.js",
    "./carousel.js": "./carousel.js",
    "./hover.js": "./hover.js",
    "./video.js": "./video.js",
    "./lightbox.js": "./lightbox.js",
    "./shared.js": "./shared.js",
    "./render.js": "./render.js",
    "./data/tokens.json": "./data/tokens.json",
    "./data/tokens.data.js": "./data/tokens.data.js",
    "./index.min.js": "./index.min.js",
    "./carousel.min.js": "./carousel.min.js",
    "./hover.min.js": "./hover.min.js",
    "./video.min.js": "./video.min.js",
    "./dist/card.css": "./dist/card.css",
    "./dist/card.min.css": "./dist/card.min.css"
  },
  "files": [
    "dist/",
    "index.css",
    "ui-card.css",
    "media.css",
    "media.shapes.css",
    "media.hover.css",
    "media.tint.css",
    "media.carousel.css",
    "media.lightbox.css",
    "media.video.css",
    "content.css",
    "content.typography.css",
    "ui-media-srcset.js",
    "srcset.js",
    "index.js",
    "carousel.js",
    "hover.js",
    "video.js",
    "lightbox.js",
    "shared.js",
    "render.js",
    "data/",
    "docs/tokens.md",
    "*.min.js"
  ],
  "scripts": {
    "build": "node build.js",
    "build:tokens": "node tokens.build.js",
    "lint:tokens": "node tokens.lint.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "browser.style",
    "card",
    "css-first",
    "ui-media",
    "ui-content",
    "container-queries",
    "design-system"
  ],
  "author": "Mads Stoumann",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madsstoumann/browser-style.git",
    "directory": "ui/card"
  },
  "homepage": "https://browser.style/ui/card",
  "peerDependencies": {
    "@browser.style/base": "^1.0.11",
    "@browser.style/carousel": "^1.0.0",
    "@browser.style/common": "^1.0.13",
    "@browser.style/beacon": "^5.0.0",
    "@browser.style/chip": "^4.0.0",
    "@browser.style/lightbox": "^1.0.0",
    "@browser.style/marquee": "^5.0.0",
    "@browser.style/play": "^4.1.0",
    "@browser.style/save": "^5.0.0",
    "@browser.style/sticker": "^5.0.0"
  },

{
  "$comment": "Generated by scripts/build-palette.js from ui/base/palette.json — do not edit. Each rule is flat CSS: emit \"selector { declarations }\" inside @layer \"layer\", once per name its \"per\" asks for. A hue a designer adds needs the rules with emitForAddedHue: true; the others ship once with browser-style. \"nested\" is the same selector as written inside the component's own block, where & stands for \"scope\".",
  "steps": [
    50,
    100,
    200,
    300,
    400,
    500,
    600,
    700,
    800,
    900,
    950
  ],
  "mirror": {
    "50": 950,
    "100": 900,
    "200": 800,
    "300": 700,
    "400": 600,
    "500": 500,
    "600": 400,
    "700": 300,
    "800": 200,
    "900": 100,
    "950": 50
  },
  "accent": {
    "steps": {
      "50": "oklch(97% 0.008 258)",
      "100": "oklch(93.2% 0.019 258)",
      "200": "oklch(88.2% 0.035 258)",
      "300": "oklch(80.9% 0.063 258)",
      "400": "oklch(70.7% 0.099 258)",
      "500": "oklch(62.3% 0.128 258)",
      "600": "oklch(54.6% 0.147 258)",
      "700": "oklch(48.8% 0.146 258)",
      "800": "oklch(42.4% 0.119 258)",
      "900": "oklch(37.9% 0.088 258)",
      "950": "oklch(28.2% 0.055 258)"
    }
  },
  "fixed": {
    "white": {
      "value": "#fff",
      "text": "oklch(13% 0.028 261.692)"
    },
    "black": {
      "value": "#000",
      "text": "#fff"
    }
  },
  "text": {
    "prefer": 950,
    "min": 4.5,
    "rule": "text on a step = the hue's 950 value if its WCAG 2 contrast with the step is >= min, else #000 or #fff, whichever has the higher contrast (oklch -> sRGB clipped to gamut -> relative luminance)"
  },
  "placeholders": {
    "{name}": "what the rule is written for, by \"per\": hue = \"green\", colour = \"green-300\", step = \"300\", word = \"white\"",
    "{mirror}": "in a per-step rule: the mirror of that step (50<->950, 100<->900, 200<->800, 300<->700, 400<->600, 500<->500)",
    "{mirror-value}": "in variables: the value of the mirror step",
    "{value}": "the colour on the page-light arm, as written in palette.json (oklch())",
    "{text}": "the readable text colour on {value}, by the \"text\" rule below",
    "{mirror-text}": "the readable text colour on {mirror-value}"
  },
  "variables": {
    "per": "colour",
    "layer": "bs-core",
    "selector": ":root",
    "emitForAddedHue": true,
    "declarations": [
      "--color-{name}: light-dark({value}, {mirror-value})",
      "--color-{name}-text: light-dark({text}, {mirror-text})"
    ]
  },
  "rules": [
    {
      "id": "theme-word",
      "per": "word",
      "file": "ui/base/theme.css",
      "layer": "bs-core",
      "emitForAddedHue": false,
      "selector": ":where([theme~=\"{name}\"], [data-theme~=\"{name}\"])",
      "declarations": [
        "--_theme-base-bg: var(--color-{name})",
        "--_theme-base-c: var(--color-{name}-text)"
      ]
    },
    {
      "id": "theme-hue",
      "per": "hue",
      "file": "ui/base/theme.css",
      "layer": "bs-core",
      "emitForAddedHue": true,
      "selector": ":where([theme^=\"{name}-\"], [theme*=\" {name}-\"], [data-theme^=\"{name}-\"], [data-theme*=\" {name}-\"])",
      "declarations": [
        "--_theme-50: var(--color-{name}-50)",
        "--_theme-50-c: var(--color-{name}-50-text)",
        "--_theme-100: var(--color-{name}-100)",
        "--_theme-100-c: var(--color-{name}-100-text)",
        "--_theme-200: var(--color-{name}-200)",
        "--_theme-200-c: var(--color-{name}-200-text)",
        "--_theme-300: var(--color-{name}-300)",
        "--_theme-300-c: var(--color-{name}-300-text)",
        "--_theme-400: var(--color-{name}-400)",
        "--_theme-400-c: var(--color-{name}-400-text)",
        "--_theme-500: var(--color-{name}-500)",
        "--_theme-500-c: var(--color-{name}-500-text)",
        "--_theme-600: var(--color-{name}-600)",
        "--_theme-600-c: var(--color-{name}-600-text)",
        "--_theme-700: var(--color-{name}-700)",
        "--_theme-700-c: var(--color-{name}-700-text)",
        "--_theme-800: var(--color-{name}-800)",
        "--_theme-800-c: var(--color-{name}-800-text)",
        "--_theme-900: var(--color-{name}-900)",
        "--_theme-900-c: var(--color-{name}-900-text)",
        "--_theme-950: var(--color-{name}-950)",
        "--_theme-950-c: var(--color-{name}-950-text)"
      ]
    },
    {

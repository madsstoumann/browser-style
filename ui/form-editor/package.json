{
  "name": "@browser.style/form-editor",
  "version": "0.1.0",
  "description": "A visual editor for multi-step forms and their rules. Its only output is two JSON files: a form definition and a @browser.style/form-rules rule set, both UCF content.",
  "type": "module",
  "module": "index.js",
  "exports": {
    ".": {
      "import": "./index.js",
      "style": "./index.css"
    },
    "./style": "./index.css"
  },
  "files": [
    "index.js",
    "index.css",
    "modules/*.js"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@browser.style/form-flow": "^0.1.0",
    "@browser.style/form-rules": "^0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "browser.style",
    "web-components",
    "form",
    "editor",
    "rules",
    "no-code"
  ],
  "author": "Mads Stoumann",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madsstoumann/browser-style.git",
    "directory": "ui/form-editor"
  },
  "bugs": {
    "url": "https://github.com/madsstoumann/browser-style/issues"
  },
  "homepage": "https://browser.style/ui/form-editor"
}
